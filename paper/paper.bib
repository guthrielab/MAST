@article{Napier:2020,
	title = {Robust barcoding and identification of {Mycobacterium} tuberculosis lineages for epidemiological and clinical studies},
	volume = {12},
	issn = {1756-994X},
	url = {https://doi.org/10.1186/s13073-020-00817-3},
	doi = {10.1186/s13073-020-00817-3},
  language = {en},
	abstract = {Tuberculosis, caused by bacteria in the Mycobacterium tuberculosis complex (MTBC), is a major global public health burden. Strain-specific genomic diversity in the known lineages of MTBC is an important factor in pathogenesis that may affect virulence, transmissibility, host response and emergence of drug resistance. Fast and accurate tracking of MTBC strains is therefore crucial for infection control, and our previous work developed a 62-single nucleotide polymorphism (SNP) barcode to inform on the phylogenetic identity of 7 human lineages and 64 sub-lineages.},
	number = {1},
	urldate = {2025-08-28},
	journal = {Genome Medicine},
	author = {Napier, Gary and Campino, Susana and Merid, Yared and Abebe, Markos and Woldeamanuel, Yimtubezinash and Aseffa, Abraham and Hibberd, Martin L. and Phelan, Jody and Clark, Taane G.},
	month = {dec},
	year = {2020},
	keywords = {Diagnostics, Tuberculosis, Barcoding, Mycobacteria tuberculosis complex, Profiling, SNPs},
	pages = {114},
}

