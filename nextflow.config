manifest {
  name = 'MAST'
  author = 'Idowu Olawoye, Maxim Federov'
  homePage = 'https://github.com/guthrielab/MAST'
  description = 'Mycobacteria Amplicon Sequencing Tool'
  version = '1.0.2'
  mainScript = 'main.nf'
}

params {
  help = false
  input = null
  output = 'results'
}
process {
  // withName: '.*' {
  //   conda = 'MAST/env/mtb_amplicon.yml'
   //  cache = true
  // }
  withName: runQualityTrimming {
  cpus = 4
  }
  withName: runAlignment {
  cpus = 4
  }
  withName: runVariantCalling {
  cpus = 8
  }
  withName: runSortAndIndex {
  cpus = 8
  }
  withName: compareMutations {
  cpus = 4
  }
}

profiles {
  conda {
    conda.enabled = true
    process.conda = 'MAST/env/mtb_amplicon.yml'
  }
  docker {
    docker.enabled = true
  }
  singularity {
    singularity {
      enabled = true
      autoMounts = true
      cacheDir = "${projectDir}/singularity_cache"
    }
    process {
      withName: runQualityTrimming {
        container = 'library://idolawoye/my-collection/mast_quality-trimming:latest'
      }
      withName: runAlignment {
        container = 'https://depot.galaxyproject.org/singularity/bwa:0.7.18--h577a1d6_2'
      }
      withName: runSortAndIndex {
        container = 'https://depot.galaxyproject.org/singularity/samtools:1.21--h96c455f_1'
      }
      withName: runPrimerTrimming {
        container = 'https://depot.galaxyproject.org/singularity/ivar:1.4.3--h43eeafb_0'
      }
      withName: runVariantCalling {
        container = 'https://depot.galaxyproject.org/singularity/freebayes:1.3.9--hbefcdb2_1'
      }
      withName: runFilterVariants {
        container = 'https://depot.galaxyproject.org/singularity/bcftools:1.21--h3a4d415_1'
      }
      withName: runConvertToTSV {
        container = 'https://depot.galaxyproject.org/singularity/bcftools:1.21--h3a4d415_1'
      }
      withName: compareMutations {
        container = 'library://idolawoye/my-collection/mast_compare-mutations:latest'
      }
    }
  }
}
