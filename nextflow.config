manifest {
  name = 'MAST'
  author = 'Idowu Olawoye, Maxim Federov'
  homePage = 'https://github.com/guthrielab/MAST'
  description = 'Mycobacteria Amplicon Sequencing Tool'
  version = '1.2.0'
  mainScript = 'main.nf'
}

params {
  help = false
  input = null
  output = 'results'
  mast_dir = projectDir
}
process {
  // withName: '.*' {
  //   conda = "${projectDir}/env/mtb_amplicon.yml"
   //  cache = true
  // }
  withName: runQualityTrimming {
  cpus = 4
  }
  withName: runAlignment {
  cpus = 4
  maxForks = 1
  }
  withName: runVariantCalling {
  cpus = 8
  }
  withName: runSortAndIndex {
  cpus = 8
  }
  withName: compareMutations {
  cpus = 4
  }
}

profiles {
  conda {
    conda.enabled = true
    process.conda = "${projectDir}/env/mtb_amplicon.yml"
  }

  docker {
    docker.enabled = true
    docker.runOptions = "--security-opt seccomp=unconfined --memory=8g --memory-swap=8g"
    process.stageInMode = 'copy'
    process {
      withName: runQualityTrimming {
        container = 'quay.io/idolawoye/mast_quality-trimming'
      }
      withName: indexReference {
        container = 'quay.io/biocontainers/samtools:1.23.1--ha83d96e_0'
      }
      withName: runAlignment {
        container = 'quay.io/biocontainers/minimap2:2.31--h118bc1c_0'
      }
      withName: runSortAndIndex {
        container = 'quay.io/biocontainers/samtools:1.23.1--ha83d96e_0'
      }
      withName: runPrimerTrimming {
        container = 'quay.io/biocontainers/samtools:1.23.1--ha83d96e_0'
      }
      withName: runVariantCalling {
        container = 'quay.io/biocontainers/freebayes:1.3.9--hbefcdb2_1'
      }
      withName: runFilterVariants {
        container = 'quay.io/biocontainers/bcftools:1.23.1--hb2cee57_0'
      }
      withName: runConvertToTSV {
        container = 'quay.io/biocontainers/bcftools:1.23.1--hb2cee57_0'
      }
      withName: compareMutations {
        container = 'quay.io/idolawoye/mast_compare-mutations:v1.1.1'
      }
    }
  }

  singularity {
    singularity {
      enabled = true
      autoMounts = true
      cacheDir = "${projectDir}/singularity_cache"
    }
    process {
      withName: runQualityTrimming {
        container = 'library://idolawoye/my-collection/mast_quality-trimming:latest'
      }
      withName: indexReference {
        container = 'https://depot.galaxyproject.org/singularity/samtools:1.23.1--ha83d96e_0'
      }
      withName: runAlignment {
        container = 'https://depot.galaxyproject.org/singularity/minimap2:2.31--h118bc1c_0'
      }
      withName: runSortAndIndex {
        container = 'https://depot.galaxyproject.org/singularity/samtools:1.23.1--ha83d96e_0'
      }
      withName: runPrimerTrimming {
        container = 'https://depot.galaxyproject.org/singularity/samtools:1.23.1--ha83d96e_0'
      }
      withName: runVariantCalling {
        container = 'https://depot.galaxyproject.org/singularity/freebayes:1.3.9--hbefcdb2_1'
      }
      withName: runFilterVariants {
        container = 'https://depot.galaxyproject.org/singularity/bcftools:1.23.1--hb2cee57_0'
      }
      withName: runConvertToTSV {
        container = 'https://depot.galaxyproject.org/singularity/bcftools:1.23.1--hb2cee57_0'
      }
      withName: compareMutations {
        container = 'library://idolawoye/my-collection/mast_compare-mutations:v1.1.1'
      }
    }
  }
}
